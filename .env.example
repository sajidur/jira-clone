# Copy to .env and fill in. Used by docker-compose.yml. Never commit .env.

# PostgreSQL connection string used by the API.
DB_CONNECTION_STRING=Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Prefer;Trust Server Certificate=true;

# Password for the built-in 'admin' account (only applied when that account has no password yet).
# Leave empty to generate one; it is printed once in the API logs.
ADMIN_PASSWORD=

API_PORT=5050
WEB_PORT=3001

# URL the browser uses to reach the API (baked into the frontend at build time).
NEXT_PUBLIC_API_URL=http://194.233.85.194:5050

# Set to Development to enable Swagger UI at /swagger.
ASPNETCORE_ENVIRONMENT=Production
